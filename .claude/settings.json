{
  "extraKnownMarketplaces": {
    "earthtojake": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad",
        "ref": "latest"
      }
    }
  },
  "enabledPlugins": {
    "text-to-cad@earthtojake": true
  },
  "enabledMcpjsonServers": ["solidcraft"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-solidcraft.sh"
          }
        ]
      }
    ]
  }
}
