{
  "version": 1,
  "name": "Ball",
  "description": "Sphere or ball, with a small flat underside so it stays put on the print bed.",
  "prompt": "a ball 40 mm across",
  "category": "Basic",
  "units": "mm",
  "params": {
    "diameter": {"value": 40, "min": 5, "max": 250, "step": 0.5, "unit": "mm", "label": "Diameter"},
    "flat": {"value": 0.25, "min": 0.1, "max": 0.6, "step": 0.05, "label": "Flat base (fraction)"}
  },
  "shape": {
    "type": "translate", "offset": [0, 0, "-(diameter/2 - sqrt(diameter^2/4 - (flat*diameter/2)^2))"],
    "child": {"type": "intersect", "comment": "sphere with its bottom sliced flat", "children": [
      {"type": "sphere", "radius": "diameter/2"},
      {"type": "translate", "offset": [0, 0, "diameter/2 - sqrt(diameter^2/4 - (flat*diameter/2)^2)"],
       "child": {"type": "box", "size": ["diameter + 2", "diameter + 2", "diameter + 2"]}}
    ]}
  }
}
