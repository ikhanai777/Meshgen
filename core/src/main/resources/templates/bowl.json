{
  "version": 1,
  "name": "Bowl",
  "description": "Round bowl with a flat base so it prints without supports.",
  "prompt": "a small round bowl for keys",
  "category": "Kitchen",
  "units": "mm",
  "params": {
    "diameter": {"value": 120, "min": 40, "max": 250, "step": 1, "unit": "mm", "label": "Diameter"},
    "depth": {"value": 50, "min": 15, "max": 120, "step": 1, "unit": "mm", "label": "Depth"},
    "base": {"value": 0.35, "min": 0.1, "max": 0.7, "step": 0.05, "label": "Base width (fraction)"},
    "wall": {"value": 2.4, "min": 1.2, "max": 6, "step": 0.2, "unit": "mm", "label": "Wall thickness"}
  },
  "shape": {
    "type": "shell", "thickness": "wall", "open_top": true,
    "child": {"type": "translate", "offset": [0, 0, "-(diameter/2 - sqrt(diameter^2/4 - (base*diameter/2)^2))"],
      "comment": "sphere cut flat at the base and the top",
      "child": {"type": "intersect", "children": [
        {"type": "sphere", "radius": "diameter/2"},
        {"type": "translate", "offset": [0, 0, "diameter/2 - sqrt(diameter^2/4 - (base*diameter/2)^2)"],
         "child": {"type": "box", "size": ["diameter + 2", "diameter + 2", "min(depth, diameter/2 + sqrt(diameter^2/4 - (base*diameter/2)^2))"]}}
      ]}}
  }
}
