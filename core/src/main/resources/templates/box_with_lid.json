{
  "version": 1,
  "name": "Box with lid",
  "description": "Rounded storage box and a separate friction-fit lid, printed side by side.",
  "prompt": "a small 80 by 60 mm box with a lid",
  "category": "Storage",
  "units": "mm",
  "params": {
    "length": {"value": 80, "min": 30, "max": 200, "step": 1, "unit": "mm", "label": "Length"},
    "width": {"value": 60, "min": 30, "max": 200, "step": 1, "unit": "mm", "label": "Width"},
    "height": {"value": 40, "min": 15, "max": 150, "step": 1, "unit": "mm", "label": "Height"},
    "wall": {"value": 2, "min": 1.2, "max": 5, "step": 0.2, "unit": "mm", "label": "Wall thickness"},
    "corner": {"value": 4, "min": 0.5, "max": 12, "step": 0.5, "unit": "mm", "label": "Corner radius"},
    "clearance": {"value": 0.3, "min": 0.1, "max": 0.8, "step": 0.05, "unit": "mm", "label": "Lid clearance"}
  },
  "shape": {
    "type": "union",
    "children": [
      {"type": "translate", "offset": ["-(length/2 + 5)", 0, 0], "comment": "box",
       "child": {"type": "shell", "thickness": "wall", "open_top": true,
                 "child": {"type": "box", "size": ["length", "width", "height"], "round": "min(corner, height/2 - 0.5)"}}},
      {"type": "translate", "offset": ["length/2 + 5", 0, 0], "comment": "lid: plate plus a lip that fits inside the box",
       "child": {"type": "union", "children": [
         {"type": "box", "size": ["length", "width", "wall + 0.4"], "round": "min(corner, (wall + 0.4)/2 - 0.1)"},
         {"type": "subtract", "children": [
           {"type": "translate", "offset": [0, 0, "wall"],
            "child": {"type": "box", "size": ["length - 2*wall - 2*clearance", "width - 2*wall - 2*clearance", 6]}},
           {"type": "translate", "offset": [0, 0, "wall + 1"],
            "child": {"type": "box", "size": ["length - 4*wall - 2*clearance", "width - 4*wall - 2*clearance", 7]}}
         ]}
       ]}}
    ]
  }
}
