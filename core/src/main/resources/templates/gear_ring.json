{
  "version": 1,
  "name": "Gear-like ring",
  "description": "Decorative toothed ring (not a meshing gear profile).",
  "prompt": "a gear shaped ring with 24 teeth",
  "category": "Hardware",
  "units": "mm",
  "params": {
    "diameter": {"value": 60, "min": 20, "max": 200, "step": 1, "unit": "mm", "label": "Outer diameter"},
    "hole": {"value": 30, "min": 5, "max": 180, "step": 1, "unit": "mm", "label": "Hole diameter"},
    "thickness": {"value": 8, "min": 2, "max": 40, "step": 0.5, "unit": "mm", "label": "Thickness"},
    "teeth": {"value": 24, "min": 6, "max": 80, "step": 1, "label": "Teeth", "integer": true},
    "tooth_depth": {"value": 4, "min": 1, "max": 15, "step": 0.5, "unit": "mm", "label": "Tooth depth"}
  },
  "shape": {
    "type": "subtract",
    "children": [
      {"type": "union", "children": [
        {"type": "cylinder", "radius": "diameter/2 - tooth_depth", "height": "thickness"},
        {"type": "radial_array", "count": "teeth", "radius": "diameter/2 - tooth_depth",
         "child": {"type": "box", "size": ["2*tooth_depth", "max(pi*diameter/teeth*0.45, 1)", "thickness"], "round": 0.4}}
      ]},
      {"type": "translate", "offset": [0, 0, -1],
       "child": {"type": "cylinder", "radius": "min(hole/2, diameter/2 - tooth_depth - 2)", "height": "thickness + 2"}}
    ]
  }
}
