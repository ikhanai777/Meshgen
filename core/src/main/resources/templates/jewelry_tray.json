{
  "version": 1,
  "name": "Jewelry tray",
  "description": "Low rounded tray with compartments.",
  "prompt": "a jewelry tray with 4 compartments",
  "category": "Storage",
  "units": "mm",
  "params": {
    "length": {"value": 140, "min": 60, "max": 250, "step": 1, "unit": "mm", "label": "Length"},
    "width": {"value": 90, "min": 40, "max": 200, "step": 1, "unit": "mm", "label": "Width"},
    "height": {"value": 20, "min": 10, "max": 60, "step": 1, "unit": "mm", "label": "Height"},
    "compartments": {"value": 4, "min": 1, "max": 8, "step": 1, "label": "Compartments", "integer": true},
    "wall": {"value": 2, "min": 1.2, "max": 5, "step": 0.2, "unit": "mm", "label": "Wall thickness"}
  },
  "shape": {
    "type": "union",
    "children": [
      {"type": "shell", "thickness": "wall", "open_top": true,
       "child": {"type": "box", "size": ["length", "width", "height"], "round": "min(6, height/2 - 0.5)"}},
      {"type": "linear_array", "count": "compartments", "spacing": ["(length - 2*wall)/compartments", 0, 0],
       "comment": "dividers; the first sits on the left wall",
       "child": {"type": "translate", "offset": ["-(length - 2*wall)/2", 0, "wall/2"],
                 "child": {"type": "box", "size": ["wall", "width - wall", "height - 3"]}}}
    ]
  }
}
