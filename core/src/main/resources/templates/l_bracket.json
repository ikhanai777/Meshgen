{
  "version": 1,
  "name": "L bracket",
  "description": "Right-angle bracket with a fillet and screw holes in both legs.",
  "prompt": "an L bracket for a shelf with screw holes",
  "category": "Hardware",
  "units": "mm",
  "params": {
    "width": {"value": 25, "min": 10, "max": 80, "step": 1, "unit": "mm", "label": "Width"},
    "leg": {"value": 50, "min": 20, "max": 150, "step": 1, "unit": "mm", "label": "Leg length"},
    "thickness": {"value": 5, "min": 2, "max": 12, "step": 0.5, "unit": "mm", "label": "Thickness"},
    "fillet": {"value": 6, "min": 1, "max": 20, "step": 0.5, "unit": "mm", "label": "Fillet"},
    "screw": {"value": 4.5, "min": 2.5, "max": 8, "step": 0.1, "unit": "mm", "label": "Screw hole"}
  },
  "shape": {
    "type": "subtract",
    "children": [
      {"type": "intersect", "comment": "trim fillet bulge to exact width", "children": [
        {"type": "smooth_union", "radius": "fillet", "children": [
          {"type": "translate", "offset": [0, "leg/2 - thickness/2", 0],
           "child": {"type": "box", "size": ["width", "leg", "thickness"]}},
          {"type": "box", "size": ["width", "thickness", "leg"]}
        ]},
        {"type": "translate", "offset": [0, "leg/2", 0], "child": {"type": "box", "size": ["width", "2*leg + 2", "leg + 1"]}}
      ]},
      {"type": "translate", "offset": [0, "leg*0.65", -1],
       "child": {"type": "cylinder", "radius": "screw/2", "height": "thickness + 2"}},
      {"type": "translate", "offset": [0, "thickness", "leg*0.65"],
       "child": {"type": "rotate", "angles": [90, 0, 0],
                 "child": {"type": "cylinder", "radius": "screw/2", "height": "2*thickness"}}}
    ]
  }
}
