{
  "version": 1,
  "name": "Twisted vase",
  "description": "Faceted vase that twists and narrows towards the top.",
  "prompt": "a twisted octagonal vase about 15 cm tall",
  "category": "Home",
  "units": "mm",
  "params": {
    "width": {"value": 90, "min": 40, "max": 200, "step": 1, "unit": "mm", "label": "Base width"},
    "height": {"value": 150, "min": 50, "max": 300, "step": 1, "unit": "mm", "label": "Height"},
    "sides": {"value": 8, "min": 3, "max": 16, "step": 1, "label": "Sides", "integer": true},
    "twist": {"value": 90, "min": -180, "max": 180, "step": 5, "unit": "°", "label": "Twist"},
    "top_scale": {"value": 0.7, "min": 0.3, "max": 1.5, "step": 0.05, "label": "Top size"},
    "wall": {"value": 2, "min": 1.2, "max": 5, "step": 0.2, "unit": "mm", "label": "Wall thickness"}
  },
  "shape": {
    "type": "shell", "thickness": "wall", "open_top": true,
    "child": {"type": "extrude", "sides": "sides", "radius": "width/2", "height": "height", "twist": "twist", "taper": "top_scale"}
  }
}
