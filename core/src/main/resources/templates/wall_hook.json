{
  "version": 1,
  "name": "Wall hook",
  "description": "Screw-mounted hook with filleted joints.",
  "prompt": "a sturdy wall hook for coats with two screw holes",
  "category": "Home",
  "units": "mm",
  "params": {
    "width": {"value": 24, "min": 12, "max": 60, "step": 1, "unit": "mm", "label": "Width"},
    "height": {"value": 70, "min": 40, "max": 150, "step": 1, "unit": "mm", "label": "Plate height"},
    "reach": {"value": 35, "min": 15, "max": 80, "step": 1, "unit": "mm", "label": "Reach"},
    "tip": {"value": 18, "min": 8, "max": 50, "step": 1, "unit": "mm", "label": "Tip height"},
    "thickness": {"value": 5, "min": 3, "max": 10, "step": 0.5, "unit": "mm", "label": "Thickness"},
    "screw": {"value": 4.5, "min": 2.5, "max": 7, "step": 0.1, "unit": "mm", "label": "Screw hole"}
  },
  "shape": {
    "type": "subtract",
    "children": [
      {"type": "intersect", "comment": "trim fillet bulge to exact width", "children": [
      {"type": "translate", "offset": [0, "reach/2", 0], "child": {"type": "box", "size": ["width", "2*reach + 2*thickness", "height + 1"]}},
      {"type": "smooth_union", "radius": 4, "children": [
        {"type": "box", "size": ["width", "thickness", "height"], "comment": "back plate"},
        {"type": "translate", "offset": [0, "reach/2", 0],
         "child": {"type": "box", "size": ["width", "reach", "thickness"], "comment": "arm"}},
        {"type": "translate", "offset": [0, "reach - thickness/2", 0],
         "child": {"type": "box", "size": ["width", "thickness", "tip"], "comment": "tip"}}
      ]}]},
      {"type": "linear_array", "count": 2, "spacing": [0, 0, "height*0.45"],
       "child": {"type": "translate", "offset": [0, "2*thickness", "height*0.4"],
                 "child": {"type": "rotate", "angles": [90, 0, 0],
                           "child": {"type": "cylinder", "radius": "screw/2", "height": "4*thickness"}}}}
    ]
  }
}
